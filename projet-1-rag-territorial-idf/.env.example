# Copier en .env puis adapter. Ne jamais versionner le fichier .env.
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.65
# Sel secret de pseudonymisation (HMAC-SHA256) : générer avec
#   python -c "import secrets; print(secrets.token_hex(32))"
RGPD_SALT=change-me-poc-local-salt
LOG_LEVEL=INFO
