{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Lancer l'application (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Indexer les documents",
      "type": "debugpy",
      "request": "launch",
      "module": "src.ingest",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
